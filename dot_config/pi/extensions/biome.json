{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "rules": {
      "style": {
        "useBlockStatements": { "level": "error", "fix": "safe" }
      },
      "suspicious": {
        "useAwait": "warn",
        "noEmptyBlockStatements": "warn"
      },
      "performance": {
        "useTopLevelRegex": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
